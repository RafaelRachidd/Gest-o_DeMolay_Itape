rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function usuarioAtivo() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.ativo == true;
    }

    function perfil() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data.perfil;
    }

    match /usuarios/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow write: if false;
    }

    match /membros/{membroId} {
      allow read: if usuarioAtivo();

      allow create, update: if usuarioAtivo()
                            && (
                              perfil() == "admin"
                              || perfil() == "secretaria"
                            );

      allow delete: if usuarioAtivo()
                    && perfil() == "admin";
    }

    match /movimentacoesFinanceiras/{movimentacaoId} {
      allow read: if usuarioAtivo();

      allow create, update: if usuarioAtivo()
                            && (
                              perfil() == "admin"
                              || perfil() == "tesouraria"
                            );

      allow delete: if usuarioAtivo()
                    && perfil() == "admin";
    }

    match /mensalidades/{mensalidadeId} {
      allow read: if usuarioAtivo();

      allow create, update: if usuarioAtivo()
                            && (
                              perfil() == "admin"
                              || perfil() == "tesouraria"
                            );

      allow delete: if usuarioAtivo()
                    && perfil() == "admin";
    }

    match /inventario/{itemId} {
      allow read: if usuarioAtivo();

      allow create, update: if usuarioAtivo()
                            && (
                              perfil() == "admin"
                              || perfil() == "patrimonio"
                            );

      allow delete: if usuarioAtivo()
                    && perfil() == "admin";
    }
  }
}